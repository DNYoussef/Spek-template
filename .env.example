# SPEK Enhanced Development Platform - Environment Variables
# Copy this file to .env and fill in your actual values

# ===================================================================
# REQUIRED API KEYS
# ===================================================================

# OpenAI API Key (required for LanceDB storage and Langroid memory)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ===================================================================
# OPTIONAL DATABASE CREDENTIALS
# ===================================================================

# ArangoDB Password (optional - only if using ArangoDB for knowledge graph)
# Default: empty string (no authentication)
ARANGODB_PASSWORD=

# ArangoDB Connection (optional)
ARANGODB_HOST=localhost
ARANGODB_PORT=8529
ARANGODB_DATABASE=spek_knowledge_graph

# ===================================================================
# DEVELOPMENT ENVIRONMENT
# ===================================================================

# Node environment
NODE_ENV=development

# Debug mode
DEBUG=false

# Port for API Gateway
API_GATEWAY_PORT=3000

# ===================================================================
# SECURITY SETTINGS
# ===================================================================

# Maximum file upload size (bytes)
MAX_UPLOAD_SIZE=10485760

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=100

# JWT secret (if using authentication)
# JWT_SECRET=your-secret-key-here

# ===================================================================
# ANALYSIS ENGINE CONFIGURATION
# ===================================================================

# Enable/disable specific analyzers
ENABLE_NASA_COMPLIANCE=true
ENABLE_CONNASCENCE_ANALYSIS=true
ENABLE_THEATER_DETECTION=true
ENABLE_SECURITY_SCANNING=true

# Analysis thresholds
NASA_COMPLIANCE_THRESHOLD=92
CONNASCENCE_THRESHOLD=85
THEATER_THRESHOLD=60
TEST_COVERAGE_THRESHOLD=80

# ===================================================================
# PERFORMANCE TUNING
# ===================================================================

# Worker thread pool size
WORKER_THREADS=4

# Cache TTL (seconds)
CACHE_TTL=3600

# Maximum concurrent analysis jobs
MAX_CONCURRENT_JOBS=10

# ===================================================================
# LOGGING & MONITORING
# ===================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Sentry DSN (optional - for error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# ===================================================================
# MCP SERVER CONFIGURATION
# ===================================================================

# Enable MCP servers
ENABLE_MCP_MEMORY=true
ENABLE_MCP_FILESYSTEM=true
ENABLE_MCP_GITHUB=true

# ===================================================================
# GITHUB INTEGRATION (Optional)
# ===================================================================

# GitHub Personal Access Token (for repository analysis)
# Get token from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here

# GitHub repository for analysis
# GITHUB_REPO=owner/repo-name

# ===================================================================
# CLOUD SERVICES (Optional)
# ===================================================================

# AWS credentials (if using AWS services)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Azure credentials (if using Azure services)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# ===================================================================
# TESTING & CI/CD
# ===================================================================

# Enable test coverage reporting
ENABLE_COVERAGE=true

# CI environment indicator
CI=false

# Test timeout (milliseconds)
TEST_TIMEOUT=60000

# ===================================================================
# NOTES
# ===================================================================
# 1. Never commit .env file to version control (already in .gitignore)
# 2. Required variables: OPENAI_API_KEY
# 3. All other variables are optional with sensible defaults
# 4. For production, use secure secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
# 5. Rotate API keys regularly (every 90 days recommended)

